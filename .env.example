# S3 Configuration
S3_ENDPOINT=http://192.168.1.100:9000
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
S3_BUCKET_NAME=mybucket

S3_REGION=us-east-1

DATABASE_URL="postgresql://postgres:password@localhost:5432/mydatabase"
BASE_URL=http://localhost:3000

# OIDC / SSO Configuration
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=your_client_id
OIDC_CLIENT_SECRET=your_client_secret
# Optional: defaults to BASE_URL + /api/auth/oidc/callback
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# Optional: defaults to the origin of OIDC_REDIRECT_URI + /auth/login
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/auth/login
# Add your SSO client scope to the requested scopes.
OIDC_SCOPES=openid profile email crabs3_permissions
# The claim mapper for the scope above must emit "permissions": ["admin"] for admins.
OIDC_ADMIN_CLAIM=permissions
OIDC_ADMIN_VALUES=admin
# "sync" synchronizes isAdmin at every login; "never_demote" preserves local admins.
OIDC_ROLE_SYNC=sync

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASS=yourpassword
SMTP_FROM="Your App <app@example.com>"

LOG_MIN_LEVEL=INFO

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_MAX_SCAN_SIZE=1992294400

CRON_SECRET="your_cron_secret"
JWT_SECRET=your_jwt_secret

EXPIRED_FILE_POLICY=cold
