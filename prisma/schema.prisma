generator client {
  provider = "prisma-client"
  output   = "./app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum SettingCategory {
  LOGGING
  STORAGE
  UPLOAD
  SECURITY
  EMAIL
  MAINTENANCE
}

model settings {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String
  type       SettingType @default(STRING)
  category   SettingCategory
  label      String
  description String?
  updated_at DateTime @updatedAt
  updated_by Int
  user       users?   @relation(fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([key])
  @@index([category])
}

model folders {
  id                String              @id
  name              String
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  files             files[]
  download_events   download_events[]
  multipart_uploads multipart_uploads[]
  services          services[]
  user_id           Int?
  user              users?              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shared_folders    Json?

  @@index([user_id])
}

model downloads {
  id            Int       @id @default(autoincrement())
  file_id       String?
  downloaded_at DateTime? @default(now()) @db.Timestamp(6)
  ip            String?
  user_agent    String?
  files         files?    @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum UploadType {
  USER
  SERVICE
}

enum ScanResult {
  CLEAN
  INFECTED
  SKIP
  WAIT
  ERROR
}

model files {
  id              String             @id
  folder_id       String?
  filename        String
  content_type    String
  size            BigInt
  uploaded_at     DateTime?          @default(now()) @db.Timestamp(6)
  expires_at      DateTime?          @db.Timestamp(6)
  storage         String?            @default("hot")
  max_downloads   Int?
  download_count  Int?               @default(0)
  password_hash   String?
  email_sender    String?
  email_recipient String?
  email_message   String?
  upload_token    String?            @unique
  download_token  String?            @unique
  downloads       downloads[]
  infected        Boolean            @default(false)
  infected_by     String?
  scanned_at      DateTime?          @db.Timestamp(6)
  scan_result     ScanResult?        @default(WAIT)
  folder          folders?           @relation(fields: [folder_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user            users?             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_id         Int?
  service         services?          @relation(fields: [service_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  service_id      Int?
  type            UploadType         @default(USER)
  download_events download_events[]
  hash            String?
  storage_key     String?

  @@index([user_id, hash])
  @@index([storage_key])
}

model download_events {
  id         Int       @id @default(autoincrement())
  file_id    String?
  files      files?    @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  folder_id  String?
  folder     folders?  @relation(fields: [folder_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  hash       String?
  ip         String?
  user_agent String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model secrets {
  id             String    @id
  content        String
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  expires_at     DateTime? @db.Timestamp(6)
  max_views      Int
  view_count     Int?      @default(0)
  password_hash  String?
  user_id        Int?
  user           users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service_id     Int?
  service        services? @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model multipart_uploads {
  file_id    String    @id
  folder_id  String?
  folder     folders?  @relation(fields: [folder_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  upload_id  String
  filename   String
  chunk_size Int
  total_size BigInt
  parts      Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model upload_tokens {
  token      String    @id
  created_at DateTime? @default(now()) @db.Timestamp(6)
  expires_at DateTime  @db.Timestamp(6)
  used       Boolean?  @default(false)
}

model invitation {
  id          String    @id @default(uuid())
  email       String    @unique
  token       String    @unique @default(uuid())
  expires_at   DateTime @db.Timestamp(6)
  usedAt      DateTime?
  created_at   DateTime  @default(now())
  invitedById Int?
  invitedBy   users?    @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
}

model session {
  id        String   @id @default(uuid())
  userId    Int
  token     String   @unique @default(uuid())
  expires_at DateTime @default(dbgenerated("(now() + interval '1 hour')")) @db.Timestamp(6)
  created_at DateTime @default(now())
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  isAdmin   Boolean  @default(false)
}

model communication {
  id          Int        @id @default(autoincrement())
  type        String
  url         String
  user_id     Int?
  user        users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  active      Boolean    @default(true)
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  @@unique([user_id, type])
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum LogAction {
  UPLOAD
  DOWNLOAD
  DELETE
  AUTH_LOGIN
  AUTH_LOGOUT
  AUTH_FAILED
  FILE_EXPIRED
  USER_CREATED
  USER_DELETED
  ADMIN_ACTION
  CREATE_SERVICE
  DELETE_SERVICE
  UPDATE_SERVICE
  SERVICE_UPLOAD
  SERVICE_DOWNLOAD
  FOLDER_RENAMED
  FOLDER_DELETED
  SERVICE_INVITE_CREATED
  SERVICE_INVITE_USED
  ACCESS_TOKEN_CREATED
  ACCESS_TOKEN_REVOKED
}

model logs {
  id         String    @id @default(cuid())
  level      LogLevel
  action     LogAction
  message    String
  meta       Json?
  user_id    Int?
  user       users?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  created_at DateTime  @default(now())

  @@index([level])
  @@index([action])
  @@index([created_at])
  @@index([user_id])
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model services {
  id         Int       @id @default(autoincrement())
  uuid       String    @default(uuid()) @unique
  name       String    @unique
  token      String    @unique
  folder_id  String?
  folder     folders?  @relation(fields: [folder_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  image      String?
  files      files[]
  secrets    secrets[]
  invites    invites[]
  quota      BigInt    @default(10737418240) // 10 GB
  status     ServiceStatus @default(ACTIVE)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model invites {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  service_id   Int
  service     services  @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expires_at   DateTime @db.Timestamp(6)
  max_uses    Int
  uses        Int       @default(0)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

enum AccessTokenScope {
  READ
  WRITE
  DELETE
  ADMIN
}

model user_access_tokens {
  id         Int       @id @default(autoincrement())
  name       String
  token      String    @unique
  scopes     AccessTokenScope[]
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  last_used_at DateTime? @db.Timestamp(6)
  user_id    Int
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, token])
}

model users {
  id                Int          @id @default(autoincrement())
  name              String
  email             String       @unique
  passwordHash      String
  created_at         DateTime     @default(now())
  files             files[]
  secrets           secrets[]
  invitesSent       invitation[] @relation("InvitedBy")
  sessions          session[]
  isAdmin           Boolean      @default(false)
  quota             BigInt       @default(10737418240) // 10 GB
  communications    communication[]
  logs              logs[]
  twoFactorEnabled  Boolean     @default(false)
  twoFactorSecret   String?
  folders           folders[]
  tokens            user_access_tokens[]
  settings          settings[]
}
